# Menu
menu.border.color: #005fff

menu.title.bg: Solid Flat
menu.title.bg.color: #000000
menu.title.bg.shadow: 0
menu.title.text.color: #005fff
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #000000
menu.items.text.color: #005fff
menu.items.disabled.text.color: #003f7f

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #000000
menu.items.active.text.color: #ffffff

menu.separator.color: #005fff
menu.separator.width: 1
menu.separator.padding.width: 0
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #000000

# Active window
window.active.border.color: #005fff


window.active.title.bg: flat solid
window.active.title.bg.color: #000000
window.active.title.separator.color: #000000
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #005fff

window.active.handle.bg: flat solid
window.active.handle.bg.color: #000000

window.active.grip.bg: flat solid
window.active.grip.bg.color: #000000

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #000000
window.active.button.unpressed.image.color: #005fff

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #000000
window.active.button.pressed.image.color: #005fff

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #000000
window.active.button.disabled.image.color: #003f7f

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #000000
window.active.button.hover.image.color: #ffffff

#window.active.button.toggled.bg: #005fff
#window.active.button.toggled.image.color: #000000

# Inactive window
window.inactive.border.color: #003f7f

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #000000
window.inactive.title.separator.color: #000000
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #003f7f

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #000000

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #000000

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #000000
window.inactive.button.unpressed.image.color: #003f7f

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #000000
window.inactive.button.pressed.image.color: #003f7f

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #000000
window.inactive.button.disabled.image.color: #001f3f

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #000000
window.inactive.button.hover.image.color: #ffffff


# OSD
osd.border.width: 1
osd.border.color: #005fff

osd.bg: flat solid
osd.bg.color: #000000
osd.label.bg: flat solid
osd.label.bg.color: #000000
osd.label.text.color: #005fff

# OSD
osd.bg: Solid Flat
osd.bg.color: #000000
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #0f1f2f
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #000000

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #000000
#osd.button.unpressed.*.border.color: #005fff

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #ffffff
#osd.button.pressed.*.border.color: #000000

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #0f1f2f
#osd.button.focused.*.border.color: #000000

osd.button.focused.box.color: #0f1f2f


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
